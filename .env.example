# アプリには --dart-define か --dart-define-from-file=config/dart_defines.json で渡します。
# このファイル自体は読み込まれません。秘密情報をコミットしないでください。

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
MAPS_API_KEY=
GEOCODING_API_KEY=

# Edge Functions 用（Supabase のシークレット。アプリには置かない）
# supabase secrets set GOOGLE_MAPS_API_KEY=...
# supabase secrets set CLOUD_OCR_URL=...
# supabase secrets set CLOUD_OCR_KEY=...
